@* @model IEnumerable<SCH.Models.Servico> *@
@model ReflectionIT.Mvc.Paging.PagingList<SCH.Models.Servico>

@{
    ViewData["Title"] = "Index";
}

<h1>Lista de Serviços(s)</h1>

<form method="get" class="form-inline">
    <div class="form-row align-items-center">
        <div class="row">
            <div class="col-sm-10 ">
                <input name="filter" class="form-control" placeholder="Pesquisar pela Descriçao do Serviço" value="@Model.RouteValue["Filter"]" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-info"> Procurar</button>
            </div>
        </div>
    </div>
</form>
<br />
<p>
    <a asp-action="Create" class="btn btn-outline-info">Cadastar Novo Serviço</a>
</p>
<div class="container mt-3">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Descricao)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Tipo)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.empresa)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Descricao)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Tipo)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.empresa.NomeEmpresa)
                    </td>
                    <td>
                        <a asp-action="Edit" class="btn btn-outline-primary" asp-route-id="@item.ServicoId">Editar</a>
                        <a asp-action="Details" class="btn btn-outline-secondary" asp-route-id="@item.ServicoId">Detalhes</a>
                        <a asp-action="Delete" class="btn btn-outline-danger" asp-route-id="@item.ServicoId">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    Total de Serviço(s) : @Model.TotalRecordCount
    <div>
        <vc:pager paging-list="@Model"></vc:pager>
    </div>
</div>