@{
}

@model SCH.Models.Movimento

<H1> Demontrativo.</H1>

<div class="row">
    <div class="col-md-12">

        <form class="form-horizontal" asp-action="RelatorioDemontrativoGeral">
            <fieldset>

                <legend><b>Planilha - Demonstrativo</b></legend>

                <div class="row">
                    

                    <div class="form-group col-sm-5 ">
                        <label for="minDate" class="col-lg-6 control-label">Data Inicial</label>
                        <div class="col-lg-10">
                            <input type="date" name="minDate" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group col-sm-5">
                        <label for="maxDate" class="col-lg-6 control-label">Data Final</label>
                        <div class="col-lg-10">
                            <input type="date" name="maxDate" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group col-sm-2">
                            <label for="teste" class="col-lg-6 control-label"></label>
                        <div class="col-lg-10 col-lg-offset-2">
                            <button type="submit" class="btn btn-primary">Enviar</button>
                        </div>
                    </div>

                </div>


                @* <div asp-validation-summary="ModelOnly" class="text-danger"></div> *@
                
            </fieldset>
        </form>
    
    </div>
</div>