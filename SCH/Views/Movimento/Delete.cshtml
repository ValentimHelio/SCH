@model SCH.Models.Movimento

@{
    ViewData["Title"] = "Delete";
}

<h1>Excluir Movimento:</h1>

<h3>Tem certeza de que deseja excluir esse Movimento?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.cliente)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.cliente.NomeCliente)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.servico)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.servico.Descricao)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Data)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Data)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Valor_Hora)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Valor_Hora)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="MovimentoId" />
        <input type="submit" value="Excluir" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-outline-info">Retornar</a>
    </form>
    
</div>
