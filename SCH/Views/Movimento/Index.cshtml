@* @model IEnumerable<SCH.Models.Movimento> *@
@model ReflectionIT.Mvc.Paging.PagingList<SCH.Models.Movimento>

@{
    ViewData["Title"] = "Index";
}

<h1>Lista de Movimento(s)</h1>

<form method="get" class="form-inline">
    <div class="form-row align-items-center">
        <div class="row">
            <div class="col-sm-10 ">
                <input name="filter" class="form-control" placeholder="Pesquisar pelo nome do Cliente" value="@Model.RouteValue["Filter"]" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-info"> Procurar</button>
            </div>
        </div>
    </div>
</form>

<br>
<p>
    <a asp-action="Create" class="btn btn-outline-info">Cadastar Novo Movimento</a>
</p>

<div class="container mt-3">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.cliente)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.servico)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Data)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Valor_Hora)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.cliente.NomeCliente)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.servico.Descricao)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Data)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Valor_Hora)
                    </td>
                    <td>
                        <a asp-action="Edit" class="btn btn-outline-primary" asp-route-id="@item.MovimentoId">Editar</a>
                        <a asp-action="Details" class="btn btn-outline-secondary" asp-route-id="@item.MovimentoId">Detalhes</a>
                        <a asp-action="Delete" class="btn btn-outline-danger" asp-route-id="@item.MovimentoId">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    Total de Movimento(s) : @Model.TotalRecordCount
    <div>
        <vc:pager paging-list="@Model"></vc:pager>
    </div>
</div>

