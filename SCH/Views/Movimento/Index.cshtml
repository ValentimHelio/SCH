@model IEnumerable<SCH.Models.Movimento>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.cliente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.servico)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Data)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Valor_Hora)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.cliente.Cep)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.servico.Descricao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Data)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Valor_Hora)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MovimentoId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MovimentoId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MovimentoId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
